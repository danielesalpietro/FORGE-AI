# =====================================================================
# FORGE-AI :: control-plane environment
# =====================================================================
#   cp compose/.env.example compose/.env
#   ./bootstrap/create-secrets.sh          # fills every CHANGEME below
#
# compose/.env is git-ignored and is created with mode 0600.
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit a real value.
#
# Every CHANGEME below is enforced: docker-compose.yml uses the
# ${VAR:?message} form, so `docker compose up` fails fast with a usable
# message rather than starting a service with an empty password.
# =====================================================================

# ---------------------------------------------------------------------
# Release / bind addresses
# ---------------------------------------------------------------------
FORGE_VERSION=1.0.0

# Where Gitea's git-over-SSH port (2222, for push/pull) is published on
# the KVM host. Loopback by default.
BIND_ADDRESS=127.0.0.1

# Where the Gitea/Semaphore web UIs (behind the TLS proxy) are
# published. Loopback by default: reach them through an SSH tunnel.
# Set to the host's LAN IP (or 0.0.0.0) to expose *only* these two
# management UIs to the LAN, without also exposing git-over-SSH above.
PROXY_BIND_ADDRESS=127.0.0.1

# The libvirt provisioning bridge address. Must match
# provisioning_network.gateway in config/poc.yml.
PROVISIONING_BIND_ADDRESS=192.168.250.1

# Root of everything FORGE-AI generates on this host. Must match
# storage.artifacts_dir in config/poc.yml.
FORGE_ARTIFACTS_DIR=/srv/forge-ai

# Docker's own bridge for the control plane. Change it if it collides
# with an existing network on this host.
DOCKER_BACKEND_SUBNET=172.28.240.0/24

# ---------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------
PROXY_HTTP_PORT=8081
PROXY_HTTPS_PORT=8443
GITEA_SSH_PORT=2222
BOOT_HTTP_PORT=8080

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_SUPERUSER=forgepg
POSTGRES_SUPERUSER_PASSWORD=CHANGEME
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=CHANGEME
SEMAPHORE_DB_NAME=semaphore
SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASSWORD=CHANGEME

# ---------------------------------------------------------------------
# Gitea
# ---------------------------------------------------------------------
GITEA_DOMAIN=gitea.poc.local
GITEA_ROOT_URL=https://gitea.poc.local:8443/
GITEA_LOG_LEVEL=Info
# How often Gitea pulls from the GitHub upstream when
# gitops.sync_strategy is "mirror".
GITEA_MIRROR_INTERVAL=10m
# openssl rand -base64 48
GITEA_SECRET_KEY=CHANGEME
GITEA_INTERNAL_TOKEN=CHANGEME
# Admin account created by bootstrap/bootstrap.sh (gitea admin user create).
GITEA_ADMIN_USER=forgeadmin
GITEA_ADMIN_EMAIL=admin@poc.local
GITEA_ADMIN_PASSWORD=CHANGEME

# ---------------------------------------------------------------------
# Semaphore
# ---------------------------------------------------------------------
SEMAPHORE_ADMIN_USER=forgeadmin
SEMAPHORE_ADMIN_NAME=FORGE-AI Administrator
SEMAPHORE_ADMIN_EMAIL=admin@poc.local
SEMAPHORE_ADMIN_PASSWORD=CHANGEME
# head -c32 /dev/urandom | base64  -- exactly 32 raw bytes.
# Losing this value means losing every key in the Semaphore Key Store.
SEMAPHORE_ACCESS_KEY_ENCRYPTION=CHANGEME
SEMAPHORE_WEB_ROOT=
# Filled in by bootstrap/bootstrap.sh after the project is created.
SEMAPHORE_API_TOKEN=
SEMAPHORE_PROJECT_ID=

# ---------------------------------------------------------------------
# GitOps
# ---------------------------------------------------------------------
GITOPS_DEFAULT_BRANCH=main
# Shared secret configured on the Gitea webhook. The receiver verifies
# HMAC-SHA256 over the raw body and rejects everything else.
FORGE_WEBHOOK_SECRET=CHANGEME
# Set to "true" to log what would be triggered without calling Semaphore.
FORGE_WEBHOOK_DRY_RUN=false
# JSON array of [path-glob, template-id] pairs, first match wins.
# A null template id means "acknowledge, run nothing".
# Populated by bootstrap/bootstrap.sh once the templates exist, e.g.
#   [["docs/**",null],["*.md",null],["**",9]]
FORGE_TEMPLATE_ROUTES=

# ---------------------------------------------------------------------
# Provisioning state service
# ---------------------------------------------------------------------
FORGE_BOOT_BASE_URL=http://192.168.250.1:8080
# Must match pxe.max_install_attempts in config/poc.yml.
FORGE_MAX_INSTALL_ATTEMPTS=3
# Optional shared token for the mutating state endpoints. Leave empty
# for an unauthenticated PoC on a truly isolated network; set it (and
# forge_state_token in the Ansible vault) to require it.
FORGE_STATE_TOKEN=
FORGE_LOG_LEVEL=INFO
