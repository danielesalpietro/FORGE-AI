# =====================================================================
# FORGE-AI :: sshd policy for {{ inventory_hostname }}
# Rendered from roles/ubuntu_baseline/templates/sshd-forge.conf.j2
# Managed state - edits here are drift and will be reverted.
# =====================================================================
# Deployment : {{ forge_deployment_id }}
# Commit     : {{ forge_git_commit }}
#
# Files in /etc/ssh/sshd_config.d/ are read in lexical order and the
# FIRST occurrence of a keyword wins. This file is 10-, so it takes
# precedence over anything the distribution or cloud-init drops in later.

PermitRootLogin {{ security.ssh_permit_root_login }}
PasswordAuthentication {{ security.ssh_password_authentication }}
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
UsePAM yes

# Session hygiene
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PrintMotd no
Banner /etc/issue.net
ClientAliveInterval 300
ClientAliveCountMax 2
LoginGraceTime 30
MaxAuthTries 4
MaxSessions 10

# Only the automation account may log in over SSH.
AllowUsers {{ users.automation_user }}

# Modern algorithms only. These lists match the Ubuntu 24.04 defaults
# with the weaker options removed; they are not a CIS benchmark.
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group-exchange-sha256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256

LogLevel VERBOSE
