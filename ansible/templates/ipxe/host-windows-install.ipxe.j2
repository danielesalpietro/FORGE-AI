#!ipxe
# =====================================================================
# FORGE-AI :: Windows Server WinPE boot script
# Host: {{ host.name }} ({{ host.mac_address }} / {{ host.ip_address }})
# Rendered from ansible/templates/ipxe/host-windows-install.ipxe.j2
# =====================================================================
# Flow: iPXE -> wimboot -> WinPE (boot.wim + BCD + boot.sdi)
#       -> startnet.cmd -> setup.exe
# Autounattend.xml is NOT injected here: it arrives on a separate
# CD-ROM (domain.xml.j2, windows_attach_unattend_cdrom), and Setup
# finds it there through its own auto-detection. See bug 28/30 in
# docs/logbook/06-fase6-provisioning-windows.md for why the earlier
# wimboot-injection approach was dropped.
#
# wimboot is the iPXE project's Windows Imaging loader. Its licence and
# attribution are recorded in THIRD_PARTY_NOTICES.md.
#
# No Microsoft binary is stored in this repository: boot.wim, BCD and
# boot.sdi are extracted on the KVM host from the operator-supplied
# Windows Server ISO by ansible/roles/windows_winpe.

set base {{ forge_boot_base_url }}
set winroot ${base}/windows/{{ host.name }}
set hostname {{ host.name }}

echo
echo [{{ host.name }}] Windows Server unattended installation (WinPE)
echo   WinPE root : ${winroot}
echo   Edition    : {{ media.windows.image_name | default('index ' ~ media.windows.image_index) }}
echo

kernel ${base}/wimboot/wimboot gui || goto failed

# The names on the left are what WinPE's boot loader looks for; the
# 'gui' flag above keeps the Windows boot animation instead of a blank
# screen, which makes PXE failures far easier to diagnose.
imgfetch --name bootmgr    ${winroot}/bootmgr.exe          bootmgr    || goto failed
imgfetch --name bcd        ${winroot}/BCD                  BCD        || goto failed
imgfetch --name boot.sdi   ${winroot}/boot.sdi             boot.sdi   || goto failed
imgfetch --name boot.wim   ${winroot}/boot.wim             boot.wim   || goto failed

# ---------------------------------------------------------------------
# Per-host file injection
# ---------------------------------------------------------------------
# wimboot injects any file beyond bootmgr/BCD/boot.sdi/*.wim into
# \Windows\System32\ inside the booted WinPE image, under the name given
# to --name (the trailing cmdline token is NOT what wimboot reads for
# this -- confirmed on a real boot after only changing the trailing
# token left the injected file named "Autounattend.xml" regardless).
# That --name mechanism is how this host gets its own startnet.cmd
# without ever writing it to a shared, world-readable location on the
# KVM host and without needing an SMB mount before the network is up.
# The answer file no longer travels this way -- see the header comment.
imgfetch --name startnet.cmd     ${winroot}/startnet.cmd     startnet.cmd     || goto failed

boot || goto failed

:failed
echo
echo [error] {{ host.name }}: WinPE failed to load.
echo         Verify with curl -I from the KVM host:
echo           ${base}/wimboot/wimboot
echo           ${winroot}/boot.wim
echo         A 404 on boot.wim means 'make prepare-media' has not run,
echo         or media.windows.iso_path is not set in config/poc.yml.
echo         See docs/TROUBLESHOOTING.md ("Windows cannot load VirtIO disk").
params
param mac ${net0/mac}
param event install-boot-failed
imgfetch --name failnote ${base}/api/log##params || echo [warn] state service unreachable
prompt --timeout 20000 Press a key to drop to the iPXE shell...
shell
