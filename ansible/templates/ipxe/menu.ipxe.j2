#!ipxe
# =====================================================================
# FORGE-AI :: interactive fallback / rescue menu
# Reached when a client has no provisioning state, or when the operator
# interrupts the automatic path. Rendered from
# ansible/templates/ipxe/menu.ipxe.j2
# =====================================================================

set base {{ forge_boot_base_url }}
set timeout {{ pxe.menu_timeout_ms }}

:menu
menu FORGE-AI provisioning -- {{ deployment.name }} -- ${net0/mac}
item --gap --             Automated profiles
{% for host in forge_hosts %}
item host-{{ loop.index }}   Install {{ host.profile }} as {{ host.name }} ({{ host.ip_address }})
{% endfor %}
item --gap --             Diagnostics
item rescue               Rescue shell (iPXE)
item netinfo              Show network configuration
item reboot               Reboot
item --gap --             Default
item local                Boot from local disk  [default]
choose --default local --timeout ${timeout} selection || goto local
goto ${selection}

{% for host in forge_hosts %}
:host-{{ loop.index }}
echo Chaining installer for {{ host.name }} ({{ host.profile }})
chain --autofree ${base}/boot/host-{{ host.mac_address | replace(':', '-') }}-install.ipxe || goto failed
{% endfor %}

:netinfo
echo
ifstat
route
echo
echo Boot server: ${base}
echo Press any key to return to the menu.
prompt
goto menu

:rescue
echo Type 'exit' to return to the menu.
shell
goto menu

:reboot
reboot

:local
# `sanboot --drive 0x80` is a BIOS/legacy INT13 trick; these guests are
# UEFI, and iPXE reports "No such device" for it here ("Boot from SAN
# device 0x80 failed: No such device", confirmed on real hardware via
# `virsh screenshot`). The exit STATUS matters too (bug 36): a plain
# `exit` returns EFI_SUCCESS and the firmware stops at its menu;
# `exit 1` returns an error, which makes BdsDxe proceed to the next
# boot option (hd).
echo Booting from local disk...
exit 1

:failed
echo
echo [error] Boot attempt failed. Returning to the menu.
prompt --timeout 10000 Press a key...
goto menu
