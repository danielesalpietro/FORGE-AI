# =====================================================================
# FORGE-AI :: dedicated dnsmasq instance
# Rendered from ansible/templates/dnsmasq/forge-dnsmasq.service.j2
# =====================================================================
# A dedicated unit, not a drop-in under /etc/dnsmasq.d, so that
# FORGE-AI never changes the behaviour of a dnsmasq this host already
# runs -- and so that teardown can stop DHCP without touching host
# networking.

[Unit]
Description=FORGE-AI provisioning DHCP/DNS/TFTP ({{ provisioning_network.name }})
Documentation=https://github.com/danielesalpietro-FORGE-AI/blob/main/docs/ARCHITECTURE.md
After=network-online.target libvirtd.service
Wants=network-online.target
# The bridge is created by libvirt; without it dnsmasq has nothing to
# bind to and would restart-loop.
Requires=libvirtd.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file={{ forge_dnsmasq_config }}
ExecStart={{ pxe_dnsmasq_binary }} --keep-in-foreground --conf-file={{ forge_dnsmasq_config }} --pid-file=
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# dnsmasq needs CAP_NET_BIND_SERVICE (ports 67/69) and CAP_NET_RAW
# (raw DHCP sockets). It needs nothing else.
User=root
Group=root
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths={{ storage.state_dir }} {{ storage.log_dir }}
ReadOnlyPaths={{ storage.tftp_root }} {{ forge_dnsmasq_config | dirname }}

[Install]
WantedBy=multi-user.target
