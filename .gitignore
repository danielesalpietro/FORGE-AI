# =====================================================================
# FORGE-AI :: .gitignore
# =====================================================================
# The first block is the important one. Everything in it is either a
# live secret or an artefact that must never enter version control, and
# .github/workflows/security.yml independently fails the build if any
# of it is committed anyway -- ignoring a file is a convenience, not a
# control.
# =====================================================================

# ---------------------------------------------------------------------
# SECRETS -- never commit
# ---------------------------------------------------------------------
compose/.env
compose/.env.*
!compose/.env.example
.env
.env.*
!.env.example

# Ansible Vault and generated vault material
ansible/inventories/*/group_vars/all/vault.yml
ansible/inventories/**/vault.yml
!ansible/inventories/**/vault.yml.example
.vault-password
.vault_pass
*.vault
vault-password*

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
!*.pub
compose/nginx/tls/*
!compose/nginx/tls/.gitkeep
secrets/
.secrets/

# Operator configuration (may reference local paths and hostnames)
config/poc.yml
!config/poc.example.yml

# Rendered artefacts that carry credentials
**/Autounattend.xml
!ansible/templates/windows/Autounattend.xml.j2
**/user-data
!ansible/templates/ubuntu/user-data.j2
**/unattend.xml
rendered/
.rendered/

# ---------------------------------------------------------------------
# LICENSED / LARGE MEDIA -- never commit
# ---------------------------------------------------------------------
*.iso
*.wim
*.esd
*.vhd
*.vhdx
*.qcow2
*.img
*.raw
*.sdi
boot.wim
install.wim
bootmgr*
wimboot
*.efi
*.kpxe
*.kkpxe
*.lkrn
*.usb
pxe/ipxe/bin/
pxe/windows/media/
pxe/ubuntu/casper/

# ---------------------------------------------------------------------
# Runtime state, logs and reports
# ---------------------------------------------------------------------
/srv/
state/
!compose/state-service/
logs/
*.log
!docs/**/*.log
reports/
*.retry
.deployment-id
artifacts/

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/
.tox/

# ---------------------------------------------------------------------
# Ansible
# ---------------------------------------------------------------------
*.retry
ansible/collections/
ansible/roles/external/
.ansible/
ansible/facts_cache/
fact_cache/

# ---------------------------------------------------------------------
# Molecule / testing
# ---------------------------------------------------------------------
.molecule/
tests/**/molecule/*/.molecule/
.cache/
.bats/

# ---------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# Node (markdownlint / prettier tooling only)
# ---------------------------------------------------------------------
node_modules/
package-lock.json
